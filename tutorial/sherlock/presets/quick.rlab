# Preset: quick — a 2-3 minute end-to-end demo on a laptop.
# Selected with `make sherlock-quick` (copied to preset.rlab, which
# config.rlab runs last, so these lines override the defaults).
C.d_model    = 64;
C.n_layer    = 2;
C.n_head     = 4;
C.d_ff       = 256;
C.T          = 64;
C.n_steps    = 400;
C.batch      = 8;
C.warmup     = 40;
C.eta_max    = 3.0e-3;
C.eta_min    = 3.0e-4;
C.log_every  = 25;
C.eval_every = 100;
C.ckpt_every = 200;
C.gen_tokens = 200;
C.ckpt_dir   = "checkpoints-quick";   # never overwrites a long run's checkpoints
