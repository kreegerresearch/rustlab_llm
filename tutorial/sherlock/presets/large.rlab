# Preset: large — a long run.  About 2.7 M parameters; on rustlab 0.3.10
# expect roughly 2-2.5 hours (extrapolated; 7+ hours on 0.3.9; see
# perf/reports/).  Lower n_steps for a shorter run.
C.d_model    = 192;
C.n_layer    = 6;
C.n_head     = 6;
C.d_ff       = 768;
C.T          = 128;
C.n_steps    = 20000;
C.batch      = 14;
C.warmup     = 500;
C.eta_max    = 1.5e-3;
C.eta_min    = 1.5e-4;
C.eval_every = 500;
C.ckpt_every = 1000;
