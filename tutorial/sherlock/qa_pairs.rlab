# Script:  qa_pairs.rlab
# System:  A hand-written instruction dataset for the Sherlock tutorial:
#          short questions about *The Adventures of Sherlock Holmes* whose
#          answers are stated literally in the text.  sft.rlab `run`s this
#          file and fine-tunes the pre-trained character GPT on it.
# Concept: Lesson 25's supervised fine-tuning data: every example is one
#          character sequence "Q: <question>\nA: <answer>\n", and a loss
#          mask that scores only the answer characters (plus the closing
#          newline) so the model learns to *respond*, not to predict the
#          question.
# Equations: ids = encode(prompt + answer + NL);  mask(t) = 1 iff t >= |prompt|
#            (position t predicts ids(t+1), the first answer character sits
#            at index |prompt| + 1).
# Units:   token ids are 1-based indices into vocab_chars; mask is 0/1.

run "../../lib/gpt.rlab"
run "config.rlab"
run "data/vocab.rlab"

# === 1. The pairs ===
# Rustlab string arrays are built in one literal and functions cannot read
# script variables, so the table lives in a function that both the script
# and qa_example() call.  qa_prompt() adds the template around a question.
function s = qa_prompt(q)
  s = "Q: " + q + sprintf("%c", 10) + "A: ";
end

function [p, a] = qa_table()
  p = {qa_prompt("Who narrates the stories?"), ...
       qa_prompt("Where does Holmes live?"), ...
       qa_prompt("Who is 'the woman'?"), ...
       qa_prompt("What instrument does Holmes play?"), ...
       qa_prompt("Who is Holmes's landlady?"), ...
       qa_prompt("What is Watson's profession?"), ...
       qa_prompt("Who hires Holmes in A Scandal in Bohemia?"), ...
       qa_prompt("What does the King want back from Irene Adler?"), ...
       qa_prompt("What does Holmes ask the King for as his reward?"), ...
       qa_prompt("What colour is Jabez Wilson's hair?"), ...
       qa_prompt("Who is Jabez Wilson's assistant?"), ...
       qa_prompt("What is Vincent Spaulding's real name?"), ...
       qa_prompt("How much did the Red-Headed League pay each week?"), ...
       qa_prompt("What did Jabez Wilson copy out for the League?"), ...
       qa_prompt("Which bank did John Clay tunnel towards?"), ...
       qa_prompt("Who is Mary Sutherland's missing bridegroom?"), ...
       qa_prompt("Who was really Hosmer Angel?"), ...
       qa_prompt("Who is accused of killing Charles McCarthy?"), ...
       qa_prompt("Who really killed Charles McCarthy?"), ...
       qa_prompt("What were Charles McCarthy's dying words about?"), ...
       qa_prompt("Which inspector works the Boscombe Valley case?"), ...
       qa_prompt("What is sent to the Openshaws as a warning?"), ...
       qa_prompt("Which letters appear on the orange-pip envelopes?"), ...
       qa_prompt("What is the name of the ship Holmes traces the pips to?"), ...
       qa_prompt("Who is the beggar Hugh Boone really?"), ...
       qa_prompt("What is the name of the opium den?"), ...
       qa_prompt("Inside which bird is the blue carbuncle found?"), ...
       qa_prompt("To whom does the blue carbuncle belong?"), ...
       qa_prompt("Who stole the blue carbuncle?"), ...
       qa_prompt("Who found the hat and the goose?"), ...
       qa_prompt("What is the speckled band?"), ...
       qa_prompt("Who is Helen Stoner's stepfather?"), ...
       qa_prompt("Where does Dr. Roylott live?"), ...
       qa_prompt("What does Holmes straighten after Roylott bends it?"), ...
       qa_prompt("What is the name of the engineer?"), ...
       qa_prompt("What did the engineer lose?"), ...
       qa_prompt("Who hired Victor Hatherley?"), ...
       qa_prompt("Who is the noble bachelor?"), ...
       qa_prompt("Who did Lord St. Simon marry?"), ...
       qa_prompt("How many beryls were missing from the coronet?"), ...
       qa_prompt("Who is the banker in The Beryl Coronet?"), ...
       qa_prompt("Who really stole the beryls?"), ...
       qa_prompt("Who is the governess at the Copper Beeches?"), ...
       qa_prompt("Who employs Violet Hunter?"), ...
       qa_prompt("What was Violet Hunter asked to cut?"), ...
       qa_prompt("What is the name of the mastiff at the Copper Beeches?")};
  a = {"Dr. Watson", ...
       "221B Baker Street", ...
       "Irene Adler", ...
       "The violin", ...
       "Mrs. Hudson", ...
       "A doctor", ...
       "The King of Bohemia", ...
       "A photograph", ...
       "The photograph", ...
       "Red", ...
       "Vincent Spaulding", ...
       "John Clay", ...
       "Four pounds", ...
       "The Encyclopaedia Britannica", ...
       "The City and Suburban Bank", ...
       "Hosmer Angel", ...
       "James Windibank", ...
       "James McCarthy", ...
       "John Turner", ...
       "A rat", ...
       "Lestrade", ...
       "Five orange pips", ...
       "K. K. K.", ...
       "The Lone Star", ...
       "Neville St. Clair", ...
       "The Bar of Gold", ...
       "A goose", ...
       "The Countess of Morcar", ...
       "James Ryder", ...
       "Peterson", ...
       "A swamp adder", ...
       "Dr. Grimesby Roylott", ...
       "Stoke Moran", ...
       "The poker", ...
       "Victor Hatherley", ...
       "His thumb", ...
       "Colonel Lysander Stark", ...
       "Lord St. Simon", ...
       "Hatty Doran", ...
       "Three", ...
       "Alexander Holder", ...
       "Sir George Burnwell", ...
       "Violet Hunter", ...
       "Jephro Rucastle", ...
       "Her hair", ...
       "Carlo"};
end

# === 2. One example as ids + prompt mask (Lesson 25) ===
# ids is the whole sequence; mask(t) scores the prediction of ids(t+1) and
# is 1 only for the answer characters and the newline that ends the answer.
function [ids, mask] = qa_example(i, vocab_chars)
  [p, a] = qa_table();
  n_p = length(gpt_encode(p(i), vocab_chars));
  ids = gpt_encode(p(i) + a(i) + sprintf("%c", 10), vocab_chars);
  T = length(ids);
  mask = zeros(T - 1);
  mask(n_p:(T - 1)) = ones(T - n_p);
end

# === 3. Expose the table and check it ===
[qa_prompts, qa_answers] = qa_table();
n_pairs = length(qa_prompts);
qa_len = zeros(n_pairs);
n_dropped = 0;
for i = 1:n_pairs
  [ids, mask] = qa_example(i, vocab_chars);
  qa_len(i) = length(ids);
  # Every character must be in the vocabulary, or gpt_encode silently drops it.
  full = qa_prompts(i) + qa_answers(i) + sprintf("%c", 10);
  n_dropped = n_dropped + (length(full) - length(ids));
  if sum(mask) != length(qa_answers(i)) + 1
    error("qa_pairs: mask of example " + sprintf("%d", i) + " does not cover the answer");
  end
end
print("qa_pairs:", n_pairs, "pairs   longest example:", max(qa_len), "chars   shortest:", min(qa_len), ...
      "   characters outside the vocabulary:", n_dropped);
[ids, mask] = qa_example(2, vocab_chars);
print("example 2 (", length(ids), "ids,", sum(mask), "scored positions ):");
print(qa_prompts(2) + qa_answers(2));
