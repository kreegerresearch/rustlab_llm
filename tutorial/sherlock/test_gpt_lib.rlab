# Script:  test_gpt_lib.rlab
# System:  Self-test for lib/gpt.rlab — finite-difference gradient check
#          on a tiny multi-layer, multi-head model, flatten/unflatten
#          round trip, and a timing probe at the tutorial's default size.
# Concept: Trust but verify (Lessons 15 and 22): every analytical gradient
#          is compared with a central difference before any training run.
# Equations: rel_err = |num - ana| / (|num| + |ana| + 1e-12) < 1e-6
# Units:   losses in nats; times in seconds.

run "../../lib/gpt.rlab"

# === 1. Tiny config, random data ===
seed(7);
cfg = gpt_config(5, 8, 2, 2, 16, 12);        # V=5, d=8, L=2, H=2, dff=16, Tmax=12
P = gpt_init(cfg, 0.3);
T = 7;
ids = randi(cfg.V, T);
mask = ones(T - 1);
print("n_params:", gpt_n_params(cfg), "  flat length:", length(gpt_flatten(P, cfg)));

# === 2. Flatten / unflatten round trip ===
theta = gpt_flatten(P, cfg);
P2 = gpt_unflatten(theta, cfg);
print("round-trip max |dWqkv|:", max(max(abs(P.Wqkv - P2.Wqkv))), " |dW_U|:", max(max(abs(P.W_U - P2.W_U))));

# === 3. Gradient check on random coordinates of the flat vector ===
function L = gpt_loss_masked(ids, mask, P, cfg)
  [lo, L, cache] = gpt_forward(ids, mask, P, cfg);
end

[lo, L0, cache] = gpt_forward(ids, mask, P, cfg);
G = gpt_backward(ids, gpt_dlogits(ids, mask, lo, cache.total), cache, P, cfg);
g = gpt_flatten(G, cfg);
eps_g = 1e-5;
n = length(theta);
seed(11);
probe = randi(n, 12);
worst = 0.0;
for k = 1:12
  i = probe(k);
  tp = theta;  tp(i) = tp(i) + eps_g;
  tm = theta;  tm(i) = tm(i) - eps_g;
  Lp = gpt_loss_masked(ids, mask, gpt_unflatten(tp, cfg), cfg);
  Lm = gpt_loss_masked(ids, mask, gpt_unflatten(tm, cfg), cfg);
  num = (Lp - Lm) / (2 * eps_g);
  ana = g(i);
  rel = abs(num - ana) / (abs(num) + abs(ana) + 1e-12);
  if rel > worst
    worst = rel;
  end
end
print("gradient check, 12 random coordinates: worst rel error =", worst, " (pass if < 1e-6)");

# Also check every parameter block once (first element of each field).
names = {"E", "Wqkv", "Wo", "W1", "b1", "W2", "b2", "g1", "be1", "g2", "be2", "gf", "bf", "W_U"};
sizes = [cfg.V * cfg.d, cfg.L * cfg.d * 3 * cfg.d, cfg.L * cfg.d * cfg.d, cfg.L * cfg.d * cfg.dff, ...
         cfg.L * cfg.dff, cfg.L * cfg.dff * cfg.d, cfg.L * cfg.d, cfg.L * cfg.d, cfg.L * cfg.d, ...
         cfg.L * cfg.d, cfg.L * cfg.d, cfg.d, cfg.d, cfg.d * cfg.V];
offset = 0;
worst_blk = 0.0;
for b = 1:14
  i = offset + 1 + mod(b * 7, sizes(b));
  tp = theta;  tp(i) = tp(i) + eps_g;
  tm = theta;  tm(i) = tm(i) - eps_g;
  num = (gpt_loss_masked(ids, mask, gpt_unflatten(tp, cfg), cfg) - gpt_loss_masked(ids, mask, gpt_unflatten(tm, cfg), cfg)) / (2 * eps_g);
  rel = abs(num - g(i)) / (abs(num) + abs(g(i)) + 1e-12);
  print("  block", names(b), " rel err =", rel);
  if rel > worst_blk
    worst_blk = rel;
  end
  offset = offset + sizes(b);
end
print("per-block check: worst rel error =", worst_blk);

# === 4. Timing at the tutorial default size ===
cfg_big = gpt_config(80, 128, 4, 4, 512, 128);
Pb = gpt_init(cfg_big, 0.02);
print("");
print("default tutorial config: params =", gpt_n_params(cfg_big));
ids_b = randi(80, 128);
tic;
[lo, Lb, cb] = gpt_forward(ids_b, ones(127), Pb, cfg_big);
t_f = toc;
tic;
Gb = gpt_backward(ids_b, gpt_dlogits(ids_b, ones(127), lo, cb.total), cb, Pb, cfg_big);
t_b = toc;
tic; gf = gpt_flatten(Gb, cfg_big); t_fl = toc;
print("forward:", t_f, "s   backward:", t_b, "s   flatten:", t_fl, "s   -> tokens/s (serial, 127 predictions):", 127 / (t_f + t_b));
print("initial loss:", Lb, " (log V =", log(80), ")");

# === 5. Data-parallel gradient over a batch with parmap ===
B = 8;
batch = zeros(B, 128);
for b = 1:B
  batch(b, :) = randi(80, 128);
end
tic;
Gm = parmap(@(b) gpt_grad_flat(batch(b, :), ones(127), Pb, cfg_big), 1:B);
t_par = toc;
g_sum = sum(Gm(:, 1:(size(Gm)(2) - 1)), 1) / B;
L_mean = mean(Gm(:, size(Gm)(2)));
print("parmap batch of", B, ": ", t_par, "s  -> tokens/s:", B * 127 / t_par, "  mean loss:", L_mean, "  |g|:", sqrt(sum(g_sum .^ 2)));
