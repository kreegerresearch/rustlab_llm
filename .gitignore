# Per-lesson .rlab script artefacts. Scripts write plots alongside
# themselves; the canonical rendered output lives under book/, so
# nothing under lessons/ besides the source files needs to be tracked.
lessons/*/*.svg
lessons/*/*.html
lessons/*/*.png
lessons/*/*.gif

# Legacy outputs/ subdirectories from the previous layout.
lessons/*/outputs/

# Interactive HTML notebook build — auto-generated `make html` output
# living alongside the committed *.md (large Plotly bundles, regenerable).
book/*.html

# macOS
.DS_Store

# Editor
.vscode/
.idea/
*.swp

# Artefacts written by lesson scripts when a notebook `run`s them: savefig
# inside a run script resolves against the notebook directory.
notebooks/*.svg
notebooks/*.png
notebooks/*.html
notebooks/*.gif
