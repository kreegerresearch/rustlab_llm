# Script:  generation_loop.rlab
# System:  Autoregressive generation loop driving the Lesson 18 24-parameter
#          bigram-style LM on the period-4 corpus over {a, b, c}.
# Concept: At each step, run the model on the *current* token, take the next-
#          token distribution, pick one token, append it, repeat.  This is the
#          basic loop every transformer-decoder uses; sampling strategies are
#          just choices of step 3.
# Equations:
#   h_t      = E(x_t, :)                          (row gather)
#   p_t      = softmax(h_t * W)                    (next-token distribution)
#   x_{t+1}  = argmax_i p_t(i)                     (greedy)
#       or   = sample_i ~ Categorical(softmax(z_t / tau))   (temperature tau)
# Units:   parameters dimensionless; loss in nats.

# Shared code: the Lesson 18 trainer and the Lesson 21 sampling helpers.
run "../../lib/bigram_lm.rlab"
run "../../lib/sampling.rlab"

# === 1. Train the Lesson 18 model (fast: 24 params, 600 steps) ===
seed(18);
vocab = 3;
d_emb = 4;

function tokens = build_seq(n)
  tokens = zeros(n);
  pat = [1, 2, 3, 2];
  for i = 1:n
    tokens(i) = pat(mod(i - 1, 4) + 1);
  end
end

corpus = build_seq(60);

# AdamW + warmup-cosine on the first 50 tokens (49 pairs), as in Lesson 18.
# seed(18) immediately above keeps the randn initialisation of E, W unchanged.
[E, W] = train_bigram_lm(corpus(1:50), vocab, d_emb, 600, 0.15, 0.015, 60);

# === 2. The forward pass becomes a one-liner ===
function p = next_token_dist(x_curr, E, W)
  p = softmax(E(x_curr, :) * W);
end

# Sanity: after training on "abcb...", P(b | a) and P(b | c) should be near 1,
# and P(a | b), P(c | b) should be near 0.5.
print("P(.|a) =", next_token_dist(1, E, W));
print("P(.|b) =", next_token_dist(2, E, W));
print("P(.|c) =", next_token_dist(3, E, W));

# === 3. Greedy decoding ===
# Pick argmax at every step.  Deterministic given the seed prompt.
function seq = greedy_generate(x0, n_new, E, W)
  seq = zeros(n_new + 1);
  seq(1) = x0;
  for t = 1:n_new
    p = next_token_dist(seq(t), E, W);
    seq(t + 1) = argmax(p);
  end
end

names = {"a", "b", "c"};
function s = seq_to_str(seq, names)
  s = "";
  for i = 1:length(seq)
    s = s + names(seq(i));
  end
end

greedy_seq = greedy_generate(1, 12, E, W);
print("greedy from 'a':", seq_to_str(greedy_seq, names));
greedy_seq_b = greedy_generate(2, 12, E, W);
print("greedy from 'b':", seq_to_str(greedy_seq_b, names));

# === 4. Temperature sampling ===
# Reshape logits by 1/tau before softmax.  tau=1 is the trained distribution;
# tau<1 sharpens (greedy as tau -> 0); tau>1 flattens (uniform as tau -> inf).
# NOTE: on this model the only uncertain row, P(.|b), has two TIED logits, and
# a tie is invariant under tau -- so the three samples below are statistically
# the same process.  See temperature_sweep.rlab for a vector tau does reshape.
# The draw itself is sample_categorical(p) from lib/sampling.rlab: inverse-CDF
# sampling that walks the cumulative distribution until it crosses r ~ U[0,1).
function seq = temperature_generate(x0, n_new, E, W, tau)
  seq = zeros(n_new + 1);
  seq(1) = x0;
  for t = 1:n_new
    logits = E(seq(t), :) * W;
    p = softmax(logits / tau);
    seq(t + 1) = sample_categorical(p);
  end
end

seed(42);
print("tau=0.5 from 'a':", seq_to_str(temperature_generate(1, 12, E, W, 0.5), names));
print("tau=1.0 from 'a':", seq_to_str(temperature_generate(1, 12, E, W, 1.0), names));
print("tau=2.0 from 'a':", seq_to_str(temperature_generate(1, 12, E, W, 2.0), names));

# === 5. Plot: P(. | b) at three temperatures ===
# 'b' is the only row with any uncertainty (split between 'a' and 'c'), and
# its two live logits are tied, so the three bar triples are identical:
# temperature scales logit *gaps* and a tie has none.
logits_b = E(2, :) * W;
print("logits at 'b':", logits_b);
p_05 = softmax(logits_b / 0.5);
p_10 = softmax(logits_b / 1.0);
p_20 = softmax(logits_b / 2.0);
print("P(.|b) at tau = 0.5 / 1 / 2:", p_05, p_10, p_20, " (identical: the tie is tau-invariant)");

figure();
bar([p_05; p_10; p_20]')
title("P(. | b) at tau = 0.5, 1, 2: the tied pair does not move")
xlabel("token (1=a, 2=b, 3=c)")
ylabel("probability")
legend("tau=0.5", "tau=1.0", "tau=2.0")
savefig("generation_loop.svg")
print("Saved generation_loop.svg");
