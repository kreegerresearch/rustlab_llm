# Script:  sampling_strategies.rlab
# System:  Single 10-class logit vector; visualise how each decoding strategy
#          reshapes the next-token distribution before drawing.
# Concept: Greedy, temperature, top-K, and top-P (nucleus) are all
#          deterministic *transformations* of the model's distribution; the
#          random draw afterwards is the same Categorical sample.
# Equations:
#   greedy:  q_i = 1 if i = argmax z, else 0
#   temp tau: q_i = softmax(z / tau)_i
#   top-K:   q_i = softmax(z)_i for i in argtop_K(z), 0 elsewhere; renormalise
#   top-P:   sort softmax(z) descending, keep prefix with sum <= P (and the
#            first element that pushes the sum past P); renormalise
# Units:   logits in nats; probabilities dimensionless; entropies in nats and bits.

run "../../lib/sampling.rlab"
run "../../lib/info.rlab"

# === A handcrafted logit vector with one near-mode, three plausible alts,
# ===  and a long tail of unlikely tokens — chosen to make the four
# ===  strategies look visibly different on the same bar chart. ===
logits = [3.0, 2.5, 2.0, 1.5, 1.0, 0.5, 0.0, -0.5, -1.0, -1.5];
K = length(logits);
p_base = softmax(logits);
print("p_base:", p_base);
print("argmax:", argmax(logits), "  p_max:", p_base(argmax(logits)));

# === Greedy ===
function q = greedy_dist(z)
  K = length(z);
  q = zeros(K);
  q(argmax(z)) = 1.0;
end

# === Temperature ===
function q = temperature_dist(z, tau)
  q = softmax(z / tau);
end

# === Top-K and top-P come from lib/sampling.rlab ===
# topk_mass(p, K_top) — keep the K_top largest entries of p, renormalise
# topp_mass(p, P)     — keep the smallest top set whose mass reaches P, renormalise

# === Compute all four ===
q_greedy = greedy_dist(logits);
q_t05    = temperature_dist(logits, 0.5);
q_t10    = temperature_dist(logits, 1.0);
q_t20    = temperature_dist(logits, 2.0);
q_k3     = topk_mass(p_base, 3);
q_p09    = topp_mass(p_base, 0.9);

print("greedy support size :", sum(q_greedy > 0));
print("tau=0.5 support size:", sum(q_t05  > 1e-6));
print("tau=2.0 support size:", sum(q_t20  > 1e-6));
print("top-K=3 support     :", sum(q_k3   > 0));
print("top-P=0.9 support   :", sum(q_p09  > 0));

# === Entropy of each transformed distribution (lib/info.rlab) — quantifies
# ===  the diversity each strategy admits.  Greedy = 0.  Uniform-ish high. ===
print("H greedy    :", entropy_nats(q_greedy), "nats  ", entropy_bits(q_greedy), "bits");
print("H tau=0.5   :", entropy_nats(q_t05), "nats  ", entropy_bits(q_t05), "bits");
print("H tau=1.0   :", entropy_nats(q_t10), "nats  ", entropy_bits(q_t10), "bits");
print("H tau=2.0   :", entropy_nats(q_t20), "nats  ", entropy_bits(q_t20), "bits");
print("H top-K=3   :", entropy_nats(q_k3), "nats  ", entropy_bits(q_k3), "bits");
print("H top-P=0.9 :", entropy_nats(q_p09), "nats  ", entropy_bits(q_p09), "bits");

# === Plot: four strategies side by side ===
figure();
subplot(2, 2, 1)
bar(1:10, q_t05)
title("Temperature tau=0.5 (sharpened)")
xlabel("token")
ylabel("probability")
ylim([0, 1])

subplot(2, 2, 2)
bar(1:10, q_t20)
title("Temperature tau=2.0 (flattened)")
xlabel("token")
ylabel("probability")
ylim([0, 1])

subplot(2, 2, 3)
bar(1:10, q_k3)
title("Top-K=3 (truncate to top 3 logits)")
xlabel("token")
ylabel("probability")
ylim([0, 1])

subplot(2, 2, 4)
bar(1:10, q_p09)
title("Top-P=0.9 (nucleus)")
xlabel("token")
ylabel("probability")
ylim([0, 1])
savefig("sampling_strategies.svg")
print("Saved sampling_strategies.svg");
