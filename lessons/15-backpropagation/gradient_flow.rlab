# Script:  gradient_flow.rlab
# System:  N-layer stack, each layer a random Jacobian with entries ~ N(0, gain^2 / d), so the
#          expected squared gain per layer is gain^2 (RMS singular value = gain).  Backprop the
#          gradient from layer N to layer 1 and record its norm at each depth; a fourth stack
#          adds the residual identity path (Jacobian I + J_f).
# Concept: gradient norm at layer k ~ ||g_N|| * gain^(N-k):  gain<1 vanish, =1 stable, >1 explode.
#          The governing quantity is the per-stage gain (singular values), not the spectral
#          radius, because a fresh J is drawn at every layer.
# Equations:
#   g_{k-1} = g_k J_k'   with  J_k = (gain / sqrt(d)) G_k,  G_k ~ N(0, I)
#   residual:  g_{k-1} = g_k + g_k J_k'          (Jacobian I + J_k)
# Units:   norms dimensionless; plotted on a log axis.

# === One random Jacobian: RMS gain vs sigma_max vs spectral radius ===
d = 32;
seed(5);
J1 = randn(d, d) / sqrt(d);
sv = svd(J1);
ev = eig(J1);
print("one random J (d = 32):  RMS singular value =", sqrt(mean(sv .^ 2)), "  sigma_max =", max(sv), "  spectral radius =", max(abs(ev)));

# === Backward through N random layers, three gains ===
N = 12;
gains = [0.7, 1.0, 1.3];
G_norms = zeros(4, N);

seed(33);
for r = 1:3
  g = randn(1, d) * 0.1;                     # upstream gradient at layer N
  for k = N:-1:1
    J = randn(d, d) / sqrt(d) * gains(r);    # entries ~ N(0, gain^2 / d)
    g = g * J';
    G_norms(r, k) = norm(g);
  end
end

# === Residual stack: identity path + branch of gain 0.7 ===
seed(34);
g = randn(1, d) * 0.1;
for k = N:-1:1
  J = randn(d, d) / sqrt(d) * 0.7;
  g = g + g * J';
  G_norms(4, k) = norm(g);
end

# === Numerical evidence ===
names = {"gain 0.7 (vanish)", "gain 1.0 (stable)", "gain 1.3 (explode)", "gain 0.7 + identity"};
for r = 1:4
  print(names(r), ":  L12 =", G_norms(r, N), "  L1 =", G_norms(r, 1), "  L1/L12 =", G_norms(r, 1) / G_norms(r, N));
end
for r = 1:4
  ratios = G_norms(r, 1:(N - 1)) ./ G_norms(r, 2:N);
  print(names(r), ":  geometric-mean per-stage gain =", exp(mean(log(ratios))));
end

# === Plot: gradient norm vs depth on a log axis ===
layers = 1:N;
figure();
hold("on")
semilogy(layers, G_norms(1, :), "color", "blue", "label", "gain 0.7 (vanish)")
semilogy(layers, G_norms(2, :), "color", "green", "label", "gain 1.0 (stable)")
semilogy(layers, G_norms(3, :), "color", "red", "label", "gain 1.3 (explode)")
semilogy(layers, G_norms(4, :), "color", "purple", "label", "gain 0.7 + identity (residual)")
title("Gradient norm vs. depth, backward from layer 12 to layer 1")
xlabel("layer k")
ylabel("||gradient at layer k||  (log scale)")
legend()
hold("off")
savefig("gradient_flow.svg")
print("Saved gradient_flow.svg");
