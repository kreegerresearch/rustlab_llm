# Script:  overfit_demo.rlab
# System:  Same embedding+head bigram model on a tiny corpus whose validation
#          set contains a transition (1 -> 3) that never appears in training.
# Concept: The train/val gap here is a train/val DISTRIBUTION MISMATCH, not a
#          capacity effect.  As the model grows confident that 1 -> 2 (the only
#          transition it ever sees from state 1), it drives P(3|1) -> 0, so the
#          held-out pair (1, 3) costs ever more.  Train loss falls to its
#          empirical floor 2*ln2/5 = 0.277 nats (states 1 and 3 deterministic;
#          the two pairs from the ambiguous state 2 cost ln2 each).
#          Visible signature: train falls to the floor, val bottoms then rises.
# Equations: same forward / backward as train_loop.rlab
# Units:    parameters dimensionless; loss in nats.

seed(180);
vocab = 3;
d_emb = 16;     # NB: width is a red herring here — any d_emb >= vocab (=3) can
                # already represent the full bigram table (rank <= |V|), so the
                # val-loss rise below is a train/val mismatch, not extra capacity.

E = randn(vocab, d_emb) * 0.3;
W = randn(d_emb, vocab) * 0.3;

# === Tiny corpus: a deterministic 5-pair training set ===
# Train pairs: (1,2), (2,3), (3,2), (2,1), (1,2).  From state 1 the model only
# ever sees 1 -> 2; from state 3 only 3 -> 2; state 2 is the sole ambiguous one
# (2 -> 3 and 2 -> 1, one each).  Empirical train floor: 2*ln2/5 = 0.277 nats.
train_pairs_curr = [1, 2, 3, 2, 1];
train_pairs_next = [2, 3, 2, 1, 2];
# Val pairs (3,2), (2,1), (1,3).  The pair (1,3) NEVER occurs in training, so a
# model that has learned 1 -> 2 assigns it vanishing probability -> val climbs.
val_pairs_curr   = [3, 2, 1];
val_pairs_next   = [2, 1, 3];

n_train_pairs = 5;
n_val_pairs = 3;

# === Forward + backward (rustlab 0.3 multi-output) ===
function [dE, dW, L] = step_grad(curr, nxt, E, W, vocab, d_emb)
  h_m = E(curr, :);
  p = softmax(h_m * W);
  L = -log(p(nxt));
  e_y = zeros(vocab); e_y(nxt) = 1.0;
  dlogits = p - e_y;
  dW = h_m' * dlogits;
  dh = dlogits * W';
  dE = zeros(vocab, d_emb);
  for k = 1:d_emb
    dE(curr, k) = dh(k);
  end
end

function L = mean_loss_pairs(currs, nexts, n_pairs, E, W)
  L = 0.0;
  for k = 1:n_pairs
    curr = currs(k);
    nxt  = nexts(k);
    h_m = E(curr, :);
    p = softmax(h_m * W);
    L = L + (-log(p(nxt)));
  end
  L = L / n_pairs;
end

# === Hyperparameters — push hard, no decay ===
n_train = 800;
beta1 = 0.9;
beta2 = 0.999;
adam_eps = 1.0e-8;
eta = 0.05;     # constant LR — no schedule, no decay
lambda_wd = 0.0;

m_E = zeros(vocab, d_emb);
v_E = zeros(vocab, d_emb);
m_W = zeros(d_emb, vocab);
v_W = zeros(d_emb, vocab);

loss_train = zeros(n_train + 1);
loss_val   = zeros(n_train + 1);
loss_train(1) = mean_loss_pairs(train_pairs_curr, train_pairs_next, n_train_pairs, E, W);
loss_val(1)   = mean_loss_pairs(val_pairs_curr,   val_pairs_next,   n_val_pairs,   E, W);

print("Initial train loss:", loss_train(1));
print("Initial val   loss:", loss_val(1));

for t = 1:n_train
  dE_sum = zeros(vocab, d_emb);
  dW_sum = zeros(d_emb, vocab);
  for k = 1:n_train_pairs
    curr = train_pairs_curr(k);
    nxt  = train_pairs_next(k);
    [dE_k, dW_k, L_k] = step_grad(curr, nxt, E, W, vocab, d_emb);
    dE_sum = dE_sum + dE_k;
    dW_sum = dW_sum + dW_k;
  end
  dE_avg = dE_sum / n_train_pairs;
  dW_avg = dW_sum / n_train_pairs;

  m_E = beta1 * m_E + (1 - beta1) * dE_avg;
  v_E = beta2 * v_E + (1 - beta2) * (dE_avg .^ 2);
  E = E - eta * (m_E / (1 - beta1 ^ t)) ./ (sqrt(v_E / (1 - beta2 ^ t)) + adam_eps);

  m_W = beta1 * m_W + (1 - beta1) * dW_avg;
  v_W = beta2 * v_W + (1 - beta2) * (dW_avg .^ 2);
  W = W - eta * (m_W / (1 - beta1 ^ t)) ./ (sqrt(v_W / (1 - beta2 ^ t)) + adam_eps);

  loss_train(t + 1) = mean_loss_pairs(train_pairs_curr, train_pairs_next, n_train_pairs, E, W);
  loss_val(t + 1)   = mean_loss_pairs(val_pairs_curr,   val_pairs_next,   n_val_pairs,   E, W);
end

print("Final train loss:", loss_train(n_train + 1));
print("Final val   loss:", loss_val(n_train + 1));
print("Train floor = 2*ln2/5 =", 2 * log(2) / 5, "nats (states 1,3 deterministic; state 2 costs ln2).");
print("Val loss rises above its initial value: the pair (1,3) never occurs in training.");

# === Plot ===
figure();
steps = 0:n_train;
plot(steps, loss_train, "color", "red",  "label", "train")
hold("on")
plot(steps, loss_val,   "color", "blue", "label", "val")
hold("off")
title("Train/val mismatch:  train falls to floor 0.277, val bottoms then rises")
xlabel("step")
ylabel("L (nats)")
legend("train", "val")
savefig("overfit_demo.svg")
print("Saved overfit_demo.svg");
