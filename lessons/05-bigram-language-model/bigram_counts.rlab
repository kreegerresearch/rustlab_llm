# Script:  bigram_counts.rlab
# System:  Character-level bigram language model
# Concept: Bigram count matrix C[i,j] = #times token j follows token i; row-normalise to
#          the row-stochastic P; add-one smoothing; row entropies and H(X_{t+1}|X_t)
# Equations: P_ij = C_ij / sum_k C_ik;  P^smooth_ij = (C_ij + 1) / (sum_k C_ik + |V|)
#            H(X_{t+1}|X_t) = sum_i pi_i H(P_i,:),  pi_i = sum_j C_ij / (T - 1)
# Units:     Counts are non-negative integers; probabilities in [0, 1]; entropies in bits

run "../../lib/info.rlab"

# === Corpus and Vocabulary ===
# Corpus: "abcbabcba"  (9 characters)
# Vocabulary: { a:1, b:2, c:3 }    vocab_size = 3
vocab_size = 3;
seq    = [1, 2, 3, 2, 1, 2, 3, 2, 1];
tokens = {"a", "b", "c"};
n_tokens  = len(seq);
n_bigrams = n_tokens - 1;

print("Corpus: abcbabcba");
print("Vocabulary: a=1  b=2  c=3");
print("Number of bigrams:", n_bigrams);

# === Build Bigram Count Matrix from the sequence ===
C = zeros(vocab_size, vocab_size);
for t = 1:n_bigrams
  C(seq(t), seq(t + 1)) = C(seq(t), seq(t + 1)) + 1;
end
print("Bigram count matrix C  (row=current, col=next):");
print(C);
print("Total bigram count (should be 8):", sum(sum(C)));

# === Row-Normalise -> row-stochastic P (one line) ===
P = C ./ sum(C, 2);
print("Row-stochastic probability matrix P:");
print(P);
print("Row sums (each should be 1):", sum(P, 2)');

# === Laplace-Smoothed Probability Matrix P_smooth ===
P_smooth = (C + 1) ./ sum(C + 1, 2);
print("Laplace-smoothed probability matrix P_smooth:");
print(P_smooth);
min_smooth = min(reshape(P_smooth, 1, vocab_size * vocab_size));
print("Minimum value in P_smooth (should be > 0):", min_smooth);

# === Row entropies and the conditional entropy ===
H_rows = row_entropies_bits(P);
pi_emp = sum(C, 2)' / sum(sum(C));
H_cond = sum(pi_emp .* H_rows);
print("Row entropies [bits] H(a), H(b), H(c):", H_rows, "  (0 = deterministic, 1 = two equal options)");
print("Current-token marginal pi:", pi_emp);
print("H(X_{t+1} | X_t) = sum_i pi_i H_i =", H_cond, "bits");

# === Heatmaps ===
figure();
subplot(1, 3, 1)
heatmap(tokens, tokens, C, "Counts C", "viridis")
subplot(1, 3, 2)
heatmap(tokens, tokens, P, "P = C ./ sum(C, 2)", "viridis")
subplot(1, 3, 3)
heatmap(tokens, tokens, P_smooth, "P_smooth (add-one)", "viridis")
savefig("bigram_counts.svg")
print("Saved bigram_counts.svg");
