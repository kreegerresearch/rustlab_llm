# Script:  bigram_sampling.rlab
# System:  Text generation via inverse-transform (CDF) sampling from a bigram language model
# Concept: Sample x_{t+1} from row P(x_t, :) by inverting its cumulative distribution;
#          decode the ids to text; training cross-entropy under P and under P_smooth
# Equations: CDF_j = sum_{k=1}^{j} P_ik;  x_{t+1} = sum(CDF < u) + 1,  u ~ Uniform(0,1)
#            L = -(1/(T-1)) sum_t log P(x_t, x_{t+1})   [nats];  ppl = exp(L)
# Units:     Probabilities in [0,1]; token ids are integers in {1,...,|V|}; loss in nats

# === Probability matrices (from bigram_counts.rlab) ===
# Corpus: "abcbabcba"   Vocab: a=1, b=2, c=3
seq    = [1, 2, 3, 2, 1, 2, 3, 2, 1];
tokens = {"a", "b", "c"};
C = [0, 2, 0; 2, 0, 2; 0, 2, 0];
P        = C ./ sum(C, 2);
P_smooth = (C + 1) ./ sum(C + 1, 2);

# === Inverse-transform sampling ===
# A uniform draw u in [0,1) maps to the token index sum(CDF < u) + 1:
# count the CDF bins strictly below u, then add 1 for the 1-based index.
print("Sampling mechanism demonstration:");
p_b = P(2, :);
cdf_b = cumsum(p_b);
print("  P(b)   =", p_b);
print("  CDF(b) =", cdf_b);
print("  u=0.3 -> sum(CDF < 0.3) + 1 =", sum(cdf_b < 0.3) + 1, "  (expect 1 = a)");
print("  u=0.7 -> sum(CDF < 0.7) + 1 =", sum(cdf_b < 0.7) + 1, "  (expect 3 = c)");

# === Generate a sequence and decode it ===
n_generate = 12;
generated = zeros(n_generate);
generated(1) = 1;   # start with token a

seed(7);            # pre-draw all uniforms for reproducibility
draws = rand(n_generate - 1);

for t = 1:(n_generate - 1)
  curr = generated(t);
  cdf = cumsum(P(curr, :));
  generated(t + 1) = sum(cdf < draws(t)) + 1;
end

gen_text = "";
for t = 1:n_generate
  gen_text = gen_text + tokens(generated(t));
end
print("Uniform draws:", draws);
print("Generated ids :", generated);
print("Generated text:", gen_text, "  (b on every even position: both a and c go to b)");

# === Training loss on the original corpus, raw vs smoothed ===
function L = corpus_ce_nats(P, seq)
  L = 0.0;
  for t = 1:(length(seq) - 1)
    L = L - log(P(seq(t), seq(t + 1)));
  end
  L = L / (length(seq) - 1);
end
mean_ce        = corpus_ce_nats(P, seq);
mean_ce_smooth = corpus_ce_nats(P_smooth, seq);
print("Training CE, raw P    :", mean_ce, "nats =", mean_ce / log(2), "bits   ppl =", exp(mean_ce));
print("Training CE, P_smooth :", mean_ce_smooth, "nats =", mean_ce_smooth / log(2), "bits   ppl =", exp(mean_ce_smooth));
print("Smoothing raises the training loss: it moves mass from seen to unseen bigrams.");

# === Plot row distributions ===
figure();
subplot(3, 1, 1)
bar(tokens, P(1, :), "P(next | a) — deterministic: always b")
ylabel("Probability")
ylim([0, 1])

subplot(3, 1, 2)
bar(tokens, P(2, :), "P(next | b) — equal: a or c")
ylabel("Probability")
ylim([0, 1])

subplot(3, 1, 3)
bar(tokens, P(3, :), "P(next | c) — deterministic: always b")
xlabel("Next token")
ylabel("Probability")
ylim([0, 1])

savefig("bigram_row_distributions.svg")
print("Saved bigram_row_distributions.svg");
