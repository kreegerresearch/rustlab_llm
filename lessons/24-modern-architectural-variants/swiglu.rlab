# Script:  swiglu.rlab
# System:  SwiGLU feed-forward block (LLaMA, Mistral, PaLM) compared to
#          the GELU + 2-matrix FFN from Lesson 11, on a 3-token,
#          d_model=8, d_ff_match-by-parameter-count setup.
# Concept: SwiGLU replaces the standard FFN
#                  FFN(x) = W2 * GELU(W1 x + b1) + b2
#          with a gated-linear-unit form:
#                  SwiGLU(x) = W3 * (Swish(W1 x) .* (W2 x))
#          where Swish(z) = z * sigmoid(z).  Three projection matrices
#          instead of two — but to keep the parameter budget similar,
#          LLaMA picks d_ff = (8/3) * d_model rather than the standard
#          4 * d_model.  The element-wise product is a MULTIPLIER between
#          two projections of the same input: for small signals
#          silu(u) ~ u/2, so each hidden unit is (x w1)(x w2)/2, an explicit
#          second-order term.  Empirically worth ~1-2 % perplexity at the
#          same parameter count (Shazeer 2020 offers no explanation).
# Equations:
#   GELU FFN:   y = W2 * GELU(W1 x + b1) + b2
#   SwiGLU FFN: u = W1 x                 (1 x d_ff_swig — gate / activated path, SiLU here)
#               v = W2 x                 (1 x d_ff_swig — the linear path)
#               y = W3 * (silu(u) .* v)
#   silu(z) = z * sigmoid(z) = z / (1 + exp(-z))
#
#   Parameter parity: standard FFN uses 2 * d_model * d_ff with d_ff = 4d
#                     -> 8 * d_model^2.  SwiGLU uses 3 * d_model * d_ff,
#                     so for parity pick d_ff = (8/3) * d_model.
# Units:   activations dimensionless.

# === 1. Setup ===
seed(23);
T = 3;
d_model = 8;
d_ff_std  = 4 * d_model;                              % 32 — standard FFN width
d_ff_swig = floor(8 * d_model / 3);                    % 21 — parity-matched
# Use integer multiple of 8 in practice; here 21 is the (8/3)*8 round.

H = randn(T, d_model);                                % (T, d_model)

# === 2. Standard GELU FFN (Lesson 11) ===
W1_std = randn(d_model, d_ff_std) * 0.3;
b1_std = randn(d_ff_std) * 0.1;
W2_std = randn(d_ff_std, d_model) * 0.3;
b2_std = randn(d_model) * 0.1;

function H_out = ffn_gelu(H, W1, b1, W2, b2)
  T = size(H)(1);
  d_ff = size(W1)(2);
  pre = H * W1 + repmat(b1, T, 1);
  post = gelu(pre);
  H_out = post * W2 + repmat(b2, T, 1);
end

H_std = ffn_gelu(H, W1_std, b1_std, W2_std, b2_std);

# === 3. SwiGLU FFN (LLaMA, Mistral) ===
W1_swig = randn(d_model, d_ff_swig) * 0.3;            % gate path
W2_swig = randn(d_model, d_ff_swig) * 0.3;            % linear path
W3_swig = randn(d_ff_swig, d_model) * 0.3;            % down projection

function y = silu(z)
  y = z ./ (1.0 + exp(-z));
end

function H_out = ffn_swiglu(H, W1, W2, W3)
  T = size(H)(1);
  gate = H * W1;                                       % (T, d_ff)
  linr = H * W2;                                       % (T, d_ff)
  acted = silu(gate) .* linr;                          % element-wise gate
  H_out = acted * W3;                                  % (T, d_model)
end

H_swig = ffn_swiglu(H, W1_swig, W2_swig, W3_swig);

# === 4. Parameter count comparison ===
n_std  = d_model * d_ff_std + d_ff_std + d_ff_std * d_model + d_model;
n_swig = d_model * d_ff_swig + d_model * d_ff_swig + d_ff_swig * d_model;
print("d_model =", d_model);
print("Standard FFN: d_ff =", d_ff_std,  "  params =", n_std);
print("SwiGLU   FFN: d_ff =", d_ff_swig, "  params =", n_swig);
print("Parameter ratio (SwiGLU / standard):", n_swig / n_std);

# === 5. Forward-pass shape check ===
print("");
print("Standard FFN output shape:", size(H_std));
print("SwiGLU   FFN output shape:", size(H_swig));
print("Both = (T, d_model) — interchangeable as a transformer sublayer.");

# === 6. Why the gate helps: the hidden unit is a multiplier ===
# One hidden unit, one input direction.  Route dimension 1 through both
# paths with gains 5 (gate) and 1 (linear): the unit computes
# silu(5 a) * a = 5 a^2 sigma(5 a) -- quadratic in the input amplitude a,
# ~2.5 a^2 for small a, ~5 a^2 for a > 0.5, switched off for a < 0.
print("");
print("Multiplier demo: one hidden unit, input amplitude a along dimension 1.");
W1_g = zeros(d_model, 1); W1_g(1, 1) = 5.0;             # gate path sees 5 a
W2_g = zeros(d_model, 1); W2_g(1, 1) = 1.0;             # linear path sees a
W3_g = zeros(1, d_model); W3_g(1, 1) = 1.0;             # back to dimension 1
for a = [0.1, 0.5, 1.0, -1.0]
  x_in = zeros(1, d_model); x_in(1, 1) = a;
  y = ffn_swiglu(x_in, W1_g, W2_g, W3_g);
  print("  a =", a, "  unit output =", y(1, 1), "  2.5 a^2 =", 2.5 * a ^ 2, "  5 a^2 =", 5 * a ^ 2);
end
print("  A linear-then-GELU path has no such product of two projections;");
print("  its second-order terms come only from the activation's curvature.");

# === 7. Figure: activations, and one unit as a product of two projections ===
z = linspace(-5, 5, 200);
a_sw = linspace(-1.5, 1.5, 301);
y_unit = silu(5 * a_sw) .* a_sw;

figure();
subplot(1, 2, 1)
plot(z, silu(z), "color", "blue",  "label", "silu (z*sigmoid(z), LLaMA/Mistral)")
hold("on")
plot(z, gelu(z), "color", "red",   "label", "gelu (Lesson 11, GPT-2)")
plot(z, relu(z), "color", "green", "label", "relu (early Transformer)")
hold("off")
title("Activation functions: silu vs gelu vs relu")
xlabel("z"); ylabel("activation")
legend("silu", "gelu", "relu")
subplot(1, 2, 2)
plot(a_sw, y_unit, "color", "blue", "label", "silu(5a) * a")
hold("on")
plot(a_sw, 2.5 * a_sw .^ 2, "color", "gray", "label", "2.5 a^2", "style", "dashed")
plot(a_sw, 5 * a_sw .^ 2, "color", "red", "label", "5 a^2", "style", "dashed")
hold("off")
title("One SwiGLU unit: a product of two projections")
xlabel("input amplitude a"); ylabel("unit output")
legend("silu(5a) * a", "2.5 a^2 (small-signal)", "5 a^2")
savefig("swiglu.svg")
print("Saved swiglu.svg");
