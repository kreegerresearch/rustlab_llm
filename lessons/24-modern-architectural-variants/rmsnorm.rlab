# Script:  rmsnorm.rlab
# System:  RMSNorm (LLaMA, Mistral, T5) compared to LayerNorm (Lesson 12)
#          on a 5-token, d_model=8 hidden-state matrix.
# Concept: LayerNorm is a DC block followed by an automatic gain control
#          (subtract the row mean, divide by the row power); RMSNorm is the
#          AGC alone.  Dropping the centering and the bias loses no quality
#          empirically and removes one reduction pass over the row — about
#          1.4x measured wall-clock on the layer.  A DC offset on the row
#          passes through RMSNorm at reduced gain and is removed by
#          LayerNorm.  Used in LLaMA, Mistral, T5, Qwen.
# Equations:
#   LayerNorm(x) = gamma * (x - mean(x)) / sqrt(var(x) + eps) + beta
#   RMSNorm(x)   = gamma * x / sqrt(mean(x^2) + eps)
#                = gamma * x / RMS(x)
# Units:   activations dimensionless; norms in the same units as inputs.

# === 1. Setup: a small hidden-state matrix ===
seed(23);
T = 5;
d_model = 8;
H = randn(T, d_model);          % (T, d_model) — each row is one token

# Per-feature scale parameter gamma (initialized to 1 — the identity).
gamma = ones(d_model);

# === 2. Implementations ===
function H_out = rmsnorm_naive(H, gamma, eps)
  T = size(H)(1);
  d = size(H)(2);
  H_out = zeros(T, d);
  for t = 1:T
    x = H(t, :);
    rms = sqrt(mean(x .^ 2) + eps);
    H_out(t) = (x / rms) .* gamma;
  end
end

function H_out = layernorm_naive(H, gamma, beta, eps)
  T = size(H)(1);
  d = size(H)(2);
  H_out = zeros(T, d);
  for t = 1:T
    x = H(t, :);
    mu = mean(x);
    sd = sqrt(mean((x - mu) .^ 2) + eps);
    H_out(t) = ((x - mu) / sd) .* gamma + beta;
  end
end

beta = zeros(d_model);
eps = 1e-5;

H_rms = rmsnorm_naive(H, gamma, eps);
H_ln  = layernorm_naive(H, gamma, beta, eps);

# === 3. Verify the row-wise property of each ===
print("=== RMSNorm row 1: mean(x^2) should be 1 after norm ===");
print("mean(H_rms(1, :)^2):", mean(H_rms(1, :) .^ 2));
print("(LayerNorm would also give 1, plus mean=0 — see below.)");
print("");
print("=== LayerNorm row 1: mean = 0, variance = 1 ===");
print("mean(H_ln(1, :)):  ", mean(H_ln(1, :)));
print("variance:          ", mean((H_ln(1, :) - mean(H_ln(1, :))) .^ 2));

# === 4. Equivalence on zero-mean inputs ===
# When the input row already has zero mean, RMSNorm and LayerNorm produce
# identical output.  Demonstrate on a centred copy:
H_centred = zeros(T, d_model);
for t = 1:T
  row = H(t, :);
  H_centred(t) = row - mean(row);
end
H_rms_c = rmsnorm_naive(H_centred, gamma, eps);
H_ln_c  = layernorm_naive(H_centred, gamma, beta, eps);
max_diff = max(max(abs(H_rms_c - H_ln_c)));
print("");
print("Zero-mean inputs: max | RMSNorm - LayerNorm | =", max_diff);
print("(Effectively zero — only difference is the eps placement under sqrt.)");

# === 5. Difference on non-zero-mean inputs ===
# Add a constant DC offset to every row; RMSNorm preserves it (scales by
# inverse RMS), LayerNorm removes it.
H_shifted = H + 2.0;
H_rms_s = rmsnorm_naive(H_shifted, gamma, eps);
H_ln_s  = layernorm_naive(H_shifted, gamma, beta, eps);
print("");
print("DC-shifted inputs: row 1 of RMSNorm output:", H_rms_s(1, :));
print("                   row 1 of LayerNorm out:", H_ln_s(1, :));
print("(LayerNorm rows match the unshifted output; RMSNorm rows do not.)");

# === 6. Why it is cheaper: reductions, not FLOPs ===
# Per row: LayerNorm = one reduction for the mean, a subtraction pass, a
# second reduction for the variance, scale, bias-add.  RMSNorm = one
# reduction (mean of squares), scale.  Normalisation is memory-bound, so
# the removed pass over the row is what matters; measured speed-ups on the
# layer are around 1.4x (Zhang & Sennrich 2019 report 7-64 % end to end).
print("");
print("LayerNorm per row: 2 reductions + 1 subtraction pass + bias add");
print("RMSNorm   per row: 1 reduction, no subtraction, no bias");
print("Measured wall-clock gain on the layer: ~1.4x (not the 2x an op count suggests).");
print("DC test: mean of shifted-row outputs  LayerNorm =", mean(H_ln_s(1, :)), "  RMSNorm =", mean(H_rms_s(1, :)));
print("AGC gain 1/RMS on row 1: unshifted", 1 / sqrt(mean(H(1, :) .^ 2)), "  shifted", 1 / sqrt(mean(H_shifted(1, :) .^ 2)));

# === 7. Figure: the DC-offset test as stem rows ===
figure();
subplot(1, 2, 1)
stem(1:d_model, H_ln(1, :))
hold("on")
stem(1:d_model, H_ln_s(1, :))
hold("off")
legend("LayerNorm(x)", "LayerNorm(x + 2)")
title("LayerNorm = DC block + AGC: the shift is removed")
xlabel("feature"); ylabel("output")
subplot(1, 2, 2)
stem(1:d_model, H_rms(1, :))
hold("on")
stem(1:d_model, H_rms_s(1, :))
hold("off")
legend("RMSNorm(x)", "RMSNorm(x + 2)")
title("RMSNorm = AGC only: the shift passes, the gain drops")
xlabel("feature"); ylabel("output")
savefig("rmsnorm.svg")
print("Saved rmsnorm.svg");
