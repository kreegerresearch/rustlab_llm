# Script:  cross_entropy_surface.rlab
# System:  Cross-entropy loss as a function of the predicted probability and of the logits
# Concept: L(p_c) = -log(p_c) is convex and unbounded in p_c; written in logits,
#          L = -z_c + LSE(z) is convex with the bounded gradient dL/dz = p_hat - y.
# Equations: L = -log(p_hat_c);  L(z) = -z_c + log(sum_j exp(z_j));  dL/dz = softmax(z) - y
# Units:     p_hat_c dimensionless in (0, 1]; logits dimensionless; loss in nats (bits = nats / ln 2)

# === Loss Curve ===
# Sample p_hat_c across the interval (0.01, 1.0]
p_hat = linspace(0.01, 1.0, 200);
loss  = -log(p_hat);            # natural log: nats

print("Cross-entropy loss at selected probabilities (nats | bits):");

# === Key reference points ===
L_50k   = -log(1.0 / 50000.0);   # uniform over a 50k vocabulary
L_4     = -log(0.25);            # uniform over 4 tokens (= log 4)
L_half  = -log(0.5);
L_high  = -log(0.9);
L_vhigh = -log(0.99);
print("  p=1/50000 :", L_50k, "|", L_50k / log(2));
print("  p=0.25    :", L_4, "|", L_4 / log(2), "  (log(4) =", log(4.0), ")");
print("  p=0.50    :", L_half, "|", L_half / log(2));
print("  p=0.90    :", L_high, "|", L_high / log(2));
print("  p=0.99    :", L_vhigh, "|", L_vhigh / log(2));

# === Plot: L(p) curve ===
figure();
hold("on")
plot(p_hat, loss, "color", "blue", "label", "L = -log(p)")
hline(L_4, "gray", "baseline = log(4)")
title("Cross-Entropy Loss vs. Predicted Probability of Correct Token")
xlabel("Predicted probability of correct token (p_c)")
ylabel("Loss L = -log(p_c)  [nats]")
ylim([0, 6])
legend()
hold("off")
savefig("cross_entropy_surface.svg")
print("Saved cross_entropy_surface.svg")

# === Gradient with respect to the logits: dL/dz = p_hat - y ===
# dL/dp_c = -1/p_c is unbounded, but the optimiser sees dL/dz, which is not:
# every component of p_hat - y lies in [-1, 1] and the vector sums to zero.
z3 = [1.0, 2.0, 0.0];             # logits; the distractor (class 2) currently wins
c3 = 1;                           # correct class
p3 = softmax(z3);
y3 = zeros(3); y3(c3) = 1.0;
g3 = p3 - y3;
L3 = -z3(c3) + log(sum(exp(z3)));  # L = -z_c + LSE(z)
print("p_hat      =", p3);
print("dL/dz      =", g3);
print("sum(dL/dz) =", sum(g3), "   max|dL/dz| =", max(abs(g3)));
print("L via LSE  =", L3, "   -log p_c =", -log(p3(c3)));

# === CE loss as a surface over logit space ===
# 3-class problem with logits z = (z1, z2, z3=0) and the correct class = 1:
#   L = -log(p1) = -z1 + log(exp(z1) + exp(z2) + 1)
n = 60;
z1_grid = linspace(-3.0, 5.0, n);
z2_grid = linspace(-3.0, 5.0, n);
[Z1, Z2] = meshgrid(z1_grid, z2_grid);

L_surface = -Z1 + log(exp(Z1) + exp(Z2) + 1.0);

L_flat = reshape(L_surface, 1, n * n);
print("Min loss on grid:", min(L_flat), "  (approached as z1 → ∞)");
print("Max loss on grid:", max(L_flat), "  (z1 most negative, z2 most positive)");

# Filled contours: evenly spaced parallel bands = the linear wall; no bands = the floor.
figure();
contourf(Z1, Z2, L_surface, 20)
title("CE loss over logit space (3-class, z3 = 0, correct = class 1)")
xlabel("z1 (correct)")
ylabel("z2 (distractor)")
savefig("cross_entropy_logit_surface.svg")
print("Saved cross_entropy_logit_surface.svg");
