# Script:  gelu_vs_relu.rlab
# System:  Activation functions inside the FFN sublayer
# Concept: Compare ReLU and GELU shapes and their derivatives (the static
#          nonlinearity's small-signal gain) side by side
# Equations:
#   ReLU(x) = max(0, x);  ReLU'(x) = 1 for x > 0, 0 for x < 0
#   GELU(x) = x * Phi(x), Phi the standard-normal CDF
#   (rustlab's gelu(), like GPT-2, uses the Hendrycks-Gimpel tanh
#    approximation — matches x*Phi(x) to ~1e-3)
#   GELU'(0) = 1/2, GELU'(x) -> 1 for x >> 0, -> 0 for x << 0
# Units:   x and y both dimensionless

run "../../lib/transformer.rlab"      # gelu_grad: analytic derivative of the tanh form

# === Sample both activations on a wide range ===
xs = linspace(-3.0, 3.0, 200);
y_relu = relu(xs);
y_gelu = gelu(xs);

# === Central finite-difference derivatives on a grid ===
h_step = 1e-4;
xs_grad = -3:0.05:3;
n_grad = length(xs_grad);
dRelu = zeros(n_grad);
dGelu = zeros(n_grad);
for i = 1:n_grad
  x = xs_grad(i);
  dRelu(i) = (relu(x + h_step) - relu(x - h_step)) / (2.0 * h_step);
  dGelu(i) = (gelu(x + h_step) - gelu(x - h_step)) / (2.0 * h_step);
end

i_neg  = round((-0.5 - xs_grad(1)) / 0.05) + 1;
i_zero = round((0.0 - xs_grad(1)) / 0.05) + 1;
print("d/dx ReLU(x = -0.5) =", dRelu(i_neg));
print("d/dx GELU(x = -0.5) =", dGelu(i_neg));
print("d/dx GELU(x =  0.0) =", dGelu(i_zero));
print("max |gelu_grad - finite difference| =", max(abs(gelu_grad(xs_grad) - dGelu)));
xs_gain = linspace(-4.0, 4.0, 801);
g_gain = gelu_grad(xs_gain);
print("gain limits: gelu_grad(-3) =", gelu_grad(-3.0), " gelu_grad(0) =", gelu_grad(0.0), " gelu_grad(3) =", gelu_grad(3.0));
print("peak gain:", max(g_gain), " at x =", xs_gain(argmax(g_gain)));

# === Plot: activations | derivatives ===
figure();
subplot(1, 2, 1)
hold("on")
plot(xs, y_relu, "color", "blue", "label", "ReLU(x)")
plot(xs, y_gelu, "color", "red",  "label", "GELU(x)")
hline(0.0, "gray", "y=0")
title("ReLU vs GELU")
xlabel("x")
ylabel("activation")
legend()
hold("off")
subplot(1, 2, 2)
hold("on")
plot(xs_grad, dRelu, "color", "blue", "label", "ReLU'(x)")
plot(xs_grad, dGelu, "color", "red",  "label", "GELU'(x)")
yline(0.5, "gray", "1/2")
title("Derivatives (small-signal gain)")
xlabel("x")
ylabel("dy/dx")
legend()
hold("off")
savefig("gelu_vs_relu.svg")
