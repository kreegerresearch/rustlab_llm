# Script:  perplexity_basics.rlab
# System:  Compute perplexity of three reference probability distributions.
# Concept: Two objects are called perplexity.  Definition 1, the PPL of a
#          distribution, is exp(H(q)) = 2^H(q): a uniform distribution over
#          K classes has PPL = K, a point mass has PPL = 1.  Definition 2,
#          the PPL of a model on data, is exp(mean -log q(x_t)) = 2^H(p,q);
#          the bridge section and the final plot keep the two apart.
# Equations:
#   H(q)   = -sum_i q_i log q_i      (nats)
#   PPL(q) = exp(H(q))               (definition 1: a distribution)
#   PPL    = exp(-mean log q(x_t))   (definition 2: a model on data)
# Units:   probabilities dimensionless; H in nats; PPL dimensionless.

# === Three reference distributions ===
p_uniform = [0.25, 0.25, 0.25, 0.25];
p_peaked  = [0.70, 0.10, 0.10, 0.10];
p_sharp   = [0.97, 0.01, 0.01, 0.01];

function ppl = entropy_to_ppl(p)
  H = -sum(p .* log(p));
  ppl = exp(H);
end

function H = entropy(p)
  H = -sum(p .* log(p));
end

# === Print entropies and PPL values ===
H_u = entropy(p_uniform);
H_p = entropy(p_peaked);
H_s = entropy(p_sharp);

print("Distribution            H (nats)    PPL");
print("uniform 0.25/0.25/...   ", H_u, "    ", entropy_to_ppl(p_uniform));
print("peaked  0.70/0.10/...   ", H_p, "    ", entropy_to_ppl(p_peaked));
print("sharp   0.97/0.01/...   ", H_s, "    ", entropy_to_ppl(p_sharp));

# === Sanity checks ===
print("Uniform PPL should equal K = 4:", entropy_to_ppl(p_uniform));
print("Sharp distribution PPL should be near 1:", entropy_to_ppl(p_sharp));

# === Bridge from cross-entropy to PPL ===
# If a model assigns probability q_target to the correct class, the per-
# example cross-entropy is L = -log q_target and per-example PPL is 1/q_target.
% (This is just exp of a single log; PPL collapses to a reciprocal probability.)
q_targets = [0.5, 0.3, 0.1, 0.01];
print("Per-example PPL = 1 / q_target  (model probability on the correct class):");
for k = 1:length(q_targets)
  q = q_targets(k);
  L_q = -log(q);
  ppl_q = exp(L_q);
  print("  q =", q, "  L =", L_q, "  PPL =", ppl_q, "  (== 1/q =", 1/q, ")");
end

# === Plot: one distribution, three perplexities ===
% Put probability p on one class and (1-p)/(K-1) on each of the K-1 others.
% Three numbers come out of the same q:
%   2^H(q)          - the distribution's own perplexity (definition 1)
%   1/p             - the model's PPL on data whose truth is the favoured class
%   (K-1)/(1-p)     - the model's PPL on data whose truth is a tail class
K = 4;
ps = linspace(1.0 / K, 0.999, 50);
ppl_dist = zeros(50);  ppl_hit = zeros(50);  ppl_miss = zeros(50);
for k = 1:50
  p = ps(k);  rest = (1 - p) / (K - 1);
  ppl_dist(k) = entropy_to_ppl([p, rest, rest, rest]);
  ppl_hit(k)  = 1 / p;
  ppl_miss(k) = 1 / rest;
end
print("at p = 1/K all three agree:", ppl_dist(1), ppl_hit(1), ppl_miss(1));
print("at p = 0.999:  2^H(q) =", ppl_dist(50), "  1/p =", ppl_hit(50), "  tail case =", ppl_miss(50));

figure();
semilogy(ps, ppl_dist, "color", "blue", "label", "2^H(q): the distribution's own PPL")
hold("on")
semilogy(ps, ppl_hit, "color", "green", "label", "model on data, truth = favoured class (1/p)")
semilogy(ps, ppl_miss, "color", "red", "label", "model on data, truth = tail class")
hold("off")
title("One distribution, three perplexities")
xlabel("probability assigned to the favoured class")
ylabel("PPL (log axis)")
savefig("perplexity_basics.svg")
print("Saved perplexity_basics.svg");
