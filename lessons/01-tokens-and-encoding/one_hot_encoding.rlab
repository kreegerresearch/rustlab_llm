# Script:  one_hot_encoding.rlab
# System:  One-hot encoding of a character sequence
# Concept: Mapping token ids to standard basis vectors in R^|V|; stacking them into X
# Equations: (e_i)_j = 1 if j == i, else 0;  e_i · e_j = delta_ij;  X = I(ids, :);  X * I = X
# Units:   Binary matrix entries (0 or 1); no physical units

# === Vocabulary and ids for "to be or not to be" ===
# Vocabulary (sorted): ' '=1, 'b'=2, 'e'=3, 'n'=4, 'o'=5, 'r'=6, 't'=7
# ids come from encode_decode.rlab
vocab_size = 7;
ids = [7, 5, 1, 2, 3, 1, 5, 6, 1, 4, 5, 7, 1, 7, 5, 1, 2, 3];
T = length(ids);

# === One-hot rows: e_i is row i of the identity ===
I = eye(vocab_size);
X = I(ids, :);                    # row t of X is e_{ids(t)}

print("One-hot matrix X for 'to be or not to be'  (18 tokens x 7 slots):");
print(X);
print("Shape (rows=tokens, cols=vocab_size):", size(X));
print("Fraction of non-zero entries (= 1/|V|):", sum(sum(X)) / (T * vocab_size));

# === Verify: each row sums to 1 (exactly one active slot per token) ===
row_sums = X * ones(vocab_size)';
print("Row sums (each must equal 1):");
print(row_sums);

# === Verify: orthogonality — e_t · e_o = 0, e_t · e_t = 1 ===
e_t = I(7, :);
e_o = I(5, :);
print("Dot product t · o (should be 0):", sum(e_t .* e_o));
print("Dot product t · t (should be 1):", sum(e_t .* e_t));

# === Lookup teaser: X * M selects rows of M (Lesson 04 uses M = E) ===
lookup_diff = max(max(abs(X * eye(vocab_size) - X)));
print("max|X * eye(|V|) - X| (should be 0):", lookup_diff);

# === Heatmap ===
# Bright = 1 (active slot), dark = 0.  Rows are labelled with the character
# at each position, columns with the vocabulary slot, so the bright cell on
# each row sits under the column for that character.
labels = {"␣", "b", "e", "n", "o", "r", "t"};
seq_labels = labels(ids);

figure();
heatmap(labels, seq_labels, X, "One-Hot Matrix X: 'to be or not to be' (18 tokens x 7 slots)", "viridis")
savefig("one_hot_matrix.svg")
print("Saved one_hot_matrix.svg")
