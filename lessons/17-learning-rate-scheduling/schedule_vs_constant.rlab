# Script:  schedule_vs_constant.rlab
# System:  Three simulated training runs on a noisy 2D quadratic.
# Concept: Compare a constant high LR (above the stability limit -> diverges),
#          a constant low LR (safe but slow to reach the floor), and a
#          warmup+cosine schedule (reaches the same floor in far fewer steps).
# Equations:
#   gradient with noise: g_t = grad(theta) + sigma * z   where z ~ N(0, I)
#   surrogate loss: L = 0.5*(10*theta1^2 + theta2^2) + 1
#   stability limit (theta1 direction, curvature 10): eta < 2/10 = 0.2
# Units:   theta dimensionless; loss in surrogate units.

seed(17);

function L = sloss(theta)
  L = 0.5 * (10.0 * theta(1) ^ 2 + theta(2) ^ 2) + 1.0;
end
function g = sgrad(theta)
  g = [10.0 * theta(1), theta(2)];
end

n_train = 300;
sigma = 0.3;
init  = [-3.0, 2.0];

# === Constant high LR (0.25 > 0.2 stability limit -> diverges) ===
theta = init;
loss_high = zeros(n_train + 1);
loss_high(1) = sloss(theta);
for t = 1:n_train
  g = sgrad(theta) + sigma * randn(2);
  theta = theta - 0.25 * g;
  loss_high(t + 1) = sloss(theta);
end

# === Constant low LR (0.02 — safe, but slow to reach the floor) ===
theta = init;
loss_low = zeros(n_train + 1);
loss_low(1) = sloss(theta);
for t = 1:n_train
  g = sgrad(theta) + sigma * randn(2);
  theta = theta - 0.02 * g;
  loss_low(t + 1) = sloss(theta);
end

# === Warmup + cosine schedule (peak 0.18, floor 0.02) ===
T_w  = 30;
T_d  = n_train;
eta_p = 0.18;
eta_f = 0.02;
theta = init;
loss_sched = zeros(n_train + 1);
loss_sched(1) = sloss(theta);
sched_curve = zeros(n_train + 1);
sched_curve(1) = 0.0;
for t = 1:n_train
  if t <= T_w
    eta_t = eta_p * (t / T_w);
  else
    progress = (t - T_w) / (T_d - T_w);
    eta_t = eta_f + 0.5 * (eta_p - eta_f) * (1 + cos(pi * progress));
  end
  sched_curve(t + 1) = eta_t;
  g = sgrad(theta) + sigma * randn(2);
  theta = theta - eta_t * g;
  loss_sched(t + 1) = sloss(theta);
end

print("Constant high LR (0.25) final loss:", loss_high(n_train + 1), " (diverged)");
print("Constant low  LR (0.02) final loss:", loss_low(n_train + 1));
print("Warmup+cosine           final loss:", loss_sched(n_train + 1));

# === Steps to reach the floor neighbourhood (first step with loss < 1.01) ===
# The noiseless bowl floors at 1.0; loss < 1.01 marks "arrived at the floor".
# Use the while idiom (rustlab has no break/continue): stop at the first hit.
thresh = 1.01;
N = n_train + 1;

i = 1;
while i < N && loss_low(i) >= thresh
  i = i + 1;
end
step_low = i - 1;                 # curve index k holds step k-1

i = 1;
while i < N && loss_sched(i) >= thresh
  i = i + 1;
end
step_sched = i - 1;

print("Steps to loss < 1.01  (constant low LR):", step_low);
print("Steps to loss < 1.01  (warmup+cosine)  :", step_sched);
print("Schedule reaches the floor ~", step_low / step_sched, "x sooner than constant-low.");

# === Loss curves overlay (log10; high LR clamped so it does not swamp the axis) ===
# The diverging high-LR loss reaches ~1e105; clamp it to 1e4 for a readable
# y-axis, then plot log10(loss) for all three so the low/schedule descent
# stays legible next to the divergence.
figure();
steps = 0:n_train;
plot(steps, log10(min(loss_high, 1.0e4)), "color", "red",   "label", "constant high LR (diverges)")
hold("on")
plot(steps, log10(loss_low),   "color", "blue",  "label", "constant low LR")
plot(steps, log10(loss_sched), "color", "green", "label", "warmup + cosine")
hold("off")
title("log10(loss) under three LR strategies (noise sigma=0.3)")
xlabel("step")
ylabel("log10 L")
legend("high (clamped 1e4)", "low", "warmup+cosine")
savefig("schedule_vs_constant.svg")
print("Saved schedule_vs_constant.svg");

# === Companion: schedule curve ===
figure();
plot(steps, sched_curve, "color", "green", "label", "warmup+cosine")
title("eta(t) used in the scheduled run")
xlabel("step")
ylabel("eta")
savefig("schedule_curve.svg")
print("Saved schedule_curve.svg");
