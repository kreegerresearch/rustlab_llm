# Script:  softmax_temperature.rlab
# System:  Softmax probability distribution over a vocabulary
# Concept: Temperature scaling of logits; sharpness vs. flatness of the output PMF
# Equations: p_i(tau) = exp(z_i / tau) / sum_j exp(z_j / tau)
# Units:     Logits are dimensionless real numbers; probabilities are in [0, 1]
#            (tau is the temperature; T is reserved for sequence length in this course)

# === Logits ===
# Four vocabulary tokens with raw scores (e.g., from a model's final layer)
z = [2.0, 1.0, 0.5, -0.5];
print("Logits z:", z);

# === Softmax at Four Temperatures ===
# tau = 0.5  →  amplifies differences  →  peaked / confident distribution
# tau = 1.0  →  standard softmax
# tau = 2.0  →  shrinks differences   →  flatter / more uncertain distribution
# tau = 5.0  →  nearly uniform
p_cold    = softmax(z / 0.5);
p_neutral = softmax(z / 1.0);
p_warm    = softmax(z / 2.0);
p_hot     = softmax(z / 5.0);

print("Probabilities at tau=0.5 (cold):", p_cold);
print("Probabilities at tau=1.0 (neutral):", p_neutral);
print("Probabilities at tau=2.0 (warm):", p_warm);
print("Probabilities at tau=5.0 (hot):", p_hot);

# === Verify: all distributions sum to 1.0 ===
print("Sums (should all be 1):", sum(p_cold), sum(p_neutral), sum(p_warm), sum(p_hot));

# === Plot: 2x2 stem plots, one PMF per temperature, 1-based token axis ===
figure();
subplot(2, 2, 1)
stem(1:4, p_cold)
title("tau = 0.5 (cold)")
ylim([0, 1])
subplot(2, 2, 2)
stem(1:4, p_neutral)
title("tau = 1.0")
ylim([0, 1])
subplot(2, 2, 3)
stem(1:4, p_warm)
title("tau = 2.0 (warm)")
ylim([0, 1])
subplot(2, 2, 4)
stem(1:4, p_hot)
title("tau = 5.0 (hot): nearly uniform")
ylim([0, 1])
savefig("softmax_temperature.svg")
print("Saved softmax_temperature.svg")
