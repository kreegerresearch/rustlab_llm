# Script:  entropy.rlab
# System:  Shannon entropy of softmax probability distributions
# Concept: Entropy measures the uncertainty (spread) of a distribution; it rises
#          monotonically with temperature between 0 and log2|V|
# Equations: H(p) = -sum_i p_i * log2(p_i)   [bits], with 0 log 0 = 0
# Units:     Entropy in bits (base-2 logarithm); tau dimensionless

run "../../lib/info.rlab"

# === Logits ===
z = [2.0, 1.0, 0.5, -0.5];
vocab_size = 4;

# === Entropy at Four Temperatures ===
# Softmax outputs are strictly positive, so the sum is written directly.
p_cold    = softmax(z / 0.5);
p_neutral = softmax(z / 1.0);
p_warm    = softmax(z / 2.0);
p_hot     = softmax(z / 5.0);

H05 = -sum(p_cold    .* log2(p_cold));
H10 = -sum(p_neutral .* log2(p_neutral));
H20 = -sum(p_warm    .* log2(p_warm));
H50 = -sum(p_hot     .* log2(p_hot));

print("Entropy at tau=0.5:", H05, "bits");
print("Entropy at tau=1.0:", H10, "bits");
print("Entropy at tau=2.0:", H20, "bits");
print("Entropy at tau=5.0:", H50, "bits");
print("Same via lib/info.rlab entropy_bits:", entropy_bits(p_neutral), "bits");

# === Theoretical bounds ===
H_max = log2(vocab_size);
print("Maximum entropy (uniform, 4 tokens):", H_max, "bits");

# === Verify: uniform achieves the maximum; near-deterministic is near 0 ===
p_uniform = ones(vocab_size) / vocab_size;
H_uniform = -sum(p_uniform .* log2(p_uniform));
print("Entropy of uniform distribution:", H_uniform, "bits  (should equal log2(4) = 2.0)");

p_det = [0.999, 0.0003, 0.0003, 0.0004];
H_det = -sum(p_det .* log2(p_det));
print("Entropy of near-deterministic distribution:", H_det, "bits  (should be ≈ 0)");

# === Entropy vs temperature: continuous curve on a log-tau axis ===
taus = logspace(log10(0.05), log10(50), 60);
H_tau = zeros(length(taus));
for k = 1:length(taus)
  H_tau(k) = entropy_bits(softmax(z / taus(k)));
end
print("H at tau=0.05:", H_tau(1), "bits   H at tau=50:", H_tau(end), "bits");

figure();
semilogx(taus, H_tau, "color", "blue", "label", "H(softmax(z / tau))")
hold("on")
yline(H_max, "red", "log2|V| = 2 (uniform)")
yline(0, "gray", "0 (argmax)")
hold("off")
title("Entropy vs temperature")
xlabel("tau (log axis)")
ylabel("H  [bits]")
savefig("entropy_vs_temperature.svg")
print("Saved entropy_vs_temperature.svg")
