# Script:  multi_head_weights.rlab
# System:  Multi-head self-attention — four heads with different attention patterns
# Concept: Run H independent scaled dot-product attentions in parallel on the
#          same sequence.  Each head has its own Q_h, K_h, so each realises a
#          different causal filter: first-sample hold, unit delay z^-1,
#          identity, growing box.  Rank and row entropy measure what a head
#          can do.  Heads 2-3 hand-write position into Q/K (Lesson 10 shows
#          where a real model gets it); head 1 keys on content.
# Equations: A_h = softmax_row((Q_h K_h^T) / sqrt(d_k) + M)   for h = 1..H
#            rank(Q_h K_h^T) <= d_k;   H_t = -sum_i A_h(t,i) log2 A_h(t,i)
# Units:     A entries dimensionless in [0, 1]; entropies in bits

run "../../lib/info.rlab"
run "../../lib/transformer.rlab"

# === Dimensions ===
T = 6;         # sequence length
H = 4;         # number of heads
d_k = 2;       # per-head key/query dimension
scale = 1.0 / sqrt(d_k);
M = causal_mask(T);          # shared additive causal mask (0 / -1e9)

function A = causal_attention_weights(Q, K, scale, M)
  S = Q * K' * scale;
  A = softmax(S + M);        # row-wise softmax of the masked scores
end

# === Head 1: "attend to the first token" (content head) ===
K1 = zeros(T, d_k);
K1(1, 1) = 3.0;
Q1 = zeros(T, d_k);
Q1(:, 1) = ones(T, 1);

# === Heads 2-3: position hand-written onto the unit circle (positional heads) ===
# K_i = 3 [cos(2 pi i/T), sin(2 pi i/T)]; head 2 queries position t-1, head 3 position t.
K2 = zeros(T, d_k);
Q2 = zeros(T, d_k);
for i = 1:T
  K2(i, 1) = 3.0 * cos(2.0 * pi * i / T);
  K2(i, 2) = 3.0 * sin(2.0 * pi * i / T);
end
for t = 1:T
  Q2(t, 1) = 3.0 * cos(2.0 * pi * (t - 1) / T);
  Q2(t, 2) = 3.0 * sin(2.0 * pi * (t - 1) / T);
end

# === Head 4: "uniform over past" (the Lesson 07 default) ===
Q4 = zeros(T, d_k);
K4 = zeros(T, d_k);

# === Attention weights ===
A1 = causal_attention_weights(Q1, K1, scale, M);
A2 = causal_attention_weights(Q2, K2, scale, M);
A3 = causal_attention_weights(K2, K2, scale, M);
A4 = causal_attention_weights(Q4, K4, scale, M);
print("Head 1 - first token:");
print(A1);
print("Head 2 - previous token:");
print(A2);
print("Head 3 - self:");
print(A3);
print("Head 4 - uniform over past:");
print(A4);

# === Checks: rows sum to 1; head 4 row 4 is the prefix average ===
row_sums = [sum(A1, 2); sum(A2, 2); sum(A3, 2); sum(A4, 2)];
print("max |row sum - 1| over all four heads:", max(abs(row_sums - 1)));
print("Head 4 row 4 (expect [0.25 0.25 0.25 0.25 0 0]):", A4(4, :));

# === Rank of each score matrix (<= d_k = 2) ===
print("rank(Q_h K_h') for heads 1..4:", rank(Q1 * K1'), rank(Q2 * K2'), rank(K2 * K2'), rank(Q4 * K4'));

# === Per-row entropies in bits against the log2 t ceiling ===
Hs = [row_entropies_bits(A1)', row_entropies_bits(A2)', row_entropies_bits(A3)', row_entropies_bits(A4)'];
print("columns: t, log2 t, head 1, head 2, head 3, head 4  (bits)");
print([(1:T)', log2(1:T)', Hs]);

# === Figure 1: the four heads as a 2x2 heatmap grid ===
positions = {"t1", "t2", "t3", "t4", "t5", "t6"};
figure();
subplot(2, 2, 1)
heatmap(positions, positions, A1, "Head 1 — first token", "viridis")
subplot(2, 2, 2)
heatmap(positions, positions, A2, "Head 2 — previous token", "viridis")
subplot(2, 2, 3)
heatmap(positions, positions, A3, "Head 3 — self", "viridis")
subplot(2, 2, 4)
heatmap(positions, positions, A4, "Head 4 — uniform", "viridis")
savefig("multi_head_attention.svg")

# === Figure 2: row 4 of each head = the filter taps seen at output time 4 ===
figure();
subplot(1, 4, 1)
stem(1:T, A1(4, :), "color", "blue")
title("head 1: first-sample hold")
subplot(1, 4, 2)
stem(1:T, A2(4, :), "color", "blue")
title("head 2: unit delay z^-1")
subplot(1, 4, 3)
stem(1:T, A3(4, :), "color", "blue")
title("head 3: identity")
subplot(1, 4, 4)
stem(1:T, A4(4, :), "color", "blue")
title("head 4: growing box")
savefig("multi_head_taps.svg")
print("Saved multi_head_attention.svg, multi_head_taps.svg");
