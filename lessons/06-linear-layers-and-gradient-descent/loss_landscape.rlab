# Script:  loss_landscape.rlab
# System:  MSE loss surface for a 1-D linear model  y_hat = w*x + b
# Concept: The loss is an exact quadratic L = 0.5 e' H e in the error e = theta - theta*;
#          the Hessian's eigenvectors are the axes of the contour ellipses and its
#          eigenvalue ratio kappa is the condition number.
# Equations: L(w,b) = 7.5w^2 + b^2 + 5wb - 30w - 10b + 30  (for x=[1,2,3,4], y=[2,4,6,8])
#            H = (2/N) [sum x^2, sum x; sum x, N] = [15, 5; 5, 2]
# Units:     w and b are dimensionless model parameters; L is in squared output units

# === Dataset ===
x = [1.0, 2.0, 3.0, 4.0];
y = [2.0, 4.0, 6.0, 8.0];
npts = 4.0;

# === Loss at true and initial parameters ===
L_true = mean((2.0 * x + 0.0 - y) .^ 2);
L_init = mean((0.0 * x + 0.0 - y) .^ 2);
print("Loss at (w=2, b=0):", L_true, "   loss at (w=0, b=0):", L_init);

# === Analytic expansion check ===
L_check = 7.5 * 4.0 + 0.0 + 5.0 * 2.0 * 0.0 - 30.0 * 2.0 - 10.0 * 0.0 + 30.0;
print("Analytic formula at (w=2, b=0):", L_check, "  (should be 0)");

# === Hessian and its eigen-decomposition ===
H = (2.0 / npts) * [sum(x .* x), sum(x); sum(x), npts];
[V, D] = eig(H);
V   = real(V);
lam = real(diag(D));
i_fast = argmax(lam);  i_slow = argmin(lam);
lam_fast = lam(i_fast);  lam_slow = lam(i_slow);
v_fast = V(:, i_fast);   v_slow = V(:, i_slow);
kappa = lam_fast / lam_slow;
print("H ="); print(H);
print("eigenvalues: fast =", lam_fast, "  slow =", lam_slow, "   kappa =", kappa);
print("fast eigenvector =", [v_fast(1), v_fast(2)], "   slow eigenvector =", [v_slow(1), v_slow(2)], "  (slope db/dw =", v_slow(2) / v_slow(1), ")");

# === Loss grid on real (w, b) axes ===
n_grid = 50;
w_grid = linspace(-0.5, 3.5, n_grid);
b_grid = linspace(-3.0, 3.0, n_grid);
[W_mesh, B_mesh] = meshgrid(w_grid, b_grid);
L_matrix = 7.5 * W_mesh .^ 2 + B_mesh .^ 2 + 5.0 * W_mesh .* B_mesh - 30.0 * W_mesh - 10.0 * B_mesh + 30.0;
min_loss_flat = min(reshape(L_matrix, 1, n_grid * n_grid));
print("Minimum loss on the grid (should be ~0):", min_loss_flat);

# === Filled contours: the dark trough is the slow eigenvector ===
figure();
contourf(W_mesh, B_mesh, L_matrix, 20)
title("MSE loss L(w, b): y = 2x, minimum at (2, 0)")
xlabel("w")
ylabel("b")
savefig("loss_landscape.svg")
print("Saved loss_landscape.svg");
