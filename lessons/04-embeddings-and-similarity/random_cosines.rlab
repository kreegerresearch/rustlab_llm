# Script:  random_cosines.rlab
# System:  Pairs of independent Gaussian vectors in R^d
# Concept: Random directions are nearly orthogonal in high dimension — the cosine of
#          two random vectors has mean 0 and standard deviation 1/sqrt(d) — which is
#          what lets d << |V| still hold a distinct direction per token
# Equations: cos = (a . b) / (||a|| ||b||);  std(cos) = 1/sqrt(d)
# Units:     Cosines dimensionless in [-1, 1]

seed(7);
n_pairs = 1000;
dims = [2, 8, 64];

figure();
for k = 1:3
  d = dims(k);
  A = randn(n_pairs, d);
  B = randn(n_pairs, d);
  c = sum(A .* B, 2) ./ (sqrt(sum(A .^ 2, 2)) .* sqrt(sum(B .^ 2, 2)));
  print("d =", d, ": mean|cos| =", mean(abs(c)), "  std(cos) =", std(c), "  1/sqrt(d) =", 1 / sqrt(d));
  subplot(1, 3, k)
  histogram(abs(c), 25);
  title(sprintf("|cos| of 1000 random pairs, d = %d", d))
  xlim([0, 1])
end
savefig("random_cosines.svg")
print("Saved random_cosines.svg")
