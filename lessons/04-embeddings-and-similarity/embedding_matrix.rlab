# Script:  embedding_matrix.rlab
# System:  Token embedding lookup via a learned embedding matrix
# Concept: E in R^(|V| x d); a one-hot row vector times E selects one dense row
# Equations: h = e_i * E = E(i, :)   (row convention: tokens are rows)
# Units:     Embedding values are dimensionless real numbers; no physical units

# === Parameters ===
vocab_size = 8;   # number of unique tokens in the vocabulary
d_embed    = 6;   # embedding dimension (d << vocab_size in practice)

# === Random Embedding Matrix Initialisation ===
# At the start of training, embeddings are drawn from a small normal distribution.
# Scale by 0.1 so initial activations are not too large (standard practice).
# Seed the shared RNG so the draw is deterministic (matches the notebook).
seed(42);
E = randn(vocab_size, d_embed) * 0.1;

print("Embedding matrix E  (shape: vocab_size x d_embed):");
print(size(E));
print(E);

# === Embedding Lookup via One-Hot Multiply ===
# Token id 3  →  one-hot row vector e3 = [0,0,1,0,0,0,0,0]
# h = e3 * E  (1x8 * 8x6 = 1x6) should equal row 3 of E exactly.
e3 = [0, 0, 1, 0, 0, 0, 0, 0];
h3 = e3 * E;

print("One-hot row vector for token 3:");
print(e3);
print("Embedded representation of token 3  (= row 3 of E):");
print(h3);
print("Row 3 of E directly:");
print(E(3, :));

# === Verify: lookup result equals the row ===
# E(3, :) is row 3 of E; E(3) would be a single column-major scalar element.
diff = max(abs(h3 - E(3, :)));
print("Max difference between lookup and direct row access (should be 0):", diff);

# === Heatmap of Embedding Matrix (signed values) ===
# Rows = tokens 1..vocab_size, columns = embedding dimensions 1..d_embed.
# At random init there is no structure; after training, related tokens' rows align.
tok_labels = {"tok1", "tok2", "tok3", "tok4", "tok5", "tok6", "tok7", "tok8"};
dim_labels = {"d1", "d2", "d3", "d4", "d5", "d6"};
figure();
heatmap(dim_labels, tok_labels, E, "Embedding Matrix E  (8 tokens x 6 dims)  — random init", "viridis")
savefig("embedding_matrix.svg")
print("Saved embedding_matrix.svg")
