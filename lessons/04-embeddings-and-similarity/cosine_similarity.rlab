# Script:  cosine_similarity.rlab
# System:  Pairwise cosine similarity between token embedding vectors
# Concept: cos(a, b) = (a · b) / (||a|| ||b||);  S = Ê Êᵀ (Gram matrix of unit rows)
# Equations: cos(a,b) = sum(a.*b) / (sqrt(sum(a.^2)) * sqrt(sum(b.^2)))
# Units:     Cosine similarity is dimensionless, in [-1, 1]

# === Hand-crafted Embeddings (by construction) ===
# Four tokens in a 4-dimensional space.
# Dimensions encode: [royalty, femininity, age, authority]
# These are illustrative — in a real model these values are learned.
king  = [1.0,  0.1,  0.8,  0.9];
queen = [0.9,  0.9,  0.7,  0.8];
man   = [0.1,  0.1,  0.6,  0.4];
woman = [0.1,  0.9,  0.5,  0.3];

print("Embedding vectors (dim=4):");
print("king :", king);
print("queen:", queen);
print("man  :", man);
print("woman:", woman);

# === Cosine Similarity Helper ===
function s = cos_sim(a, b)
  s = sum(a .* b) / (sqrt(sum(a .^ 2)) * sqrt(sum(b .^ 2)))
end

# === Three scalar cosines ===
s_kq = cos_sim(king,  queen);
s_km = cos_sim(king,  man);
s_qw = cos_sim(queen, woman);
print("king  / queen (high — both royal)     :", s_kq);
print("king  / man   (moderate — same gender):", s_km);
print("queen / woman (moderate — same gender):", s_qw);

# === Matrix form: S = Ê Êᵀ delivers all 16 entries at once ===
E4 = [king; queen; man; woman];          # 4 x 4: one embedding per row
row_norms = sqrt(sum(E4 .^ 2, 2));        # ||E_i|| for each row
En = E4 ./ row_norms;                     # Ê — unit-length rows
S = En * En';                             # S_ij = cos(E_i, E_j)
print("Cosine similarity matrix S (king, queen, man, woman):");
print(S);

# === Verify: symmetry, unit diagonal, data range ===
sym_err = max(max(abs(S - S')));
print("Symmetry check max|S - S'| (should be ~0):", sym_err);
print("min(S) =", min(min(S)), " (king/woman) — the heatmap colour scale starts here, not at -1");

# === Analogy Arithmetic: king - man + woman ≈ queen (by construction) ===
analogy = king - man + woman;
print("king - man + woman vector:", analogy);
print("Similarity of (king - man + woman) to king/queen/man/woman:",
      cos_sim(analogy, king), cos_sim(analogy, queen), cos_sim(analogy, man), cos_sim(analogy, woman));
print("Closest token should be 'queen'.");

# === Heatmap of Similarity Matrix ===
vocab = {"king", "queen", "man", "woman"};
figure();
heatmap(vocab, vocab, S, "Cosine Similarity S: king, queen, man, woman", "viridis")
savefig("cosine_similarity.svg")
print("Saved cosine_similarity.svg")
